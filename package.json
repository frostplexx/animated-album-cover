{
	"name": "animated-album-cover",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:node-appwrite --outfile=dist/main.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"dev": "appwrite run function --function-id animated-album-cover"
	},
	"dependencies": {
		"node-appwrite": "^31.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"appwrite-cli": "^28.9.0",
		"esbuild": "^0.27.0",
		"typescript": "^5.5.2",
		"vitest": "~5.0.3"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	}
}
