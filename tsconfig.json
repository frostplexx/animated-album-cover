{
	"compilerOptions": {
		/* Set the JavaScript language version for emitted JavaScript and include compatible library declarations. */
		"target": "es2024",
		/* Appwrite's node-22 runtime, plus @types/node for fetch/Response/crypto. */
		"lib": ["es2024"],
		"types": ["node"],

		/* Specify what module code is generated. */
		"module": "es2022",
		/* TypeScript looks up .ts files without extensions, which is what esbuild bundles. */
		"moduleResolution": "bundler",
		"resolveJsonModule": true,

		/* Appwrite runs the bundled output from dist/, never tsc output. */
		"noEmit": true,

		/* Appwrite's node runtime imports this file as ESM. */
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,

		/* Enable all strict type-checking options. */
		"strict": true,

		/* Skip type checking all .d.ts files. */
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
