{
    "projectId": "6addbd6a00067d04150c",
    "projectName": "animated-album-cover",
    "endpoint": "https://cloud.appwrite.io/v1",
    "functions": [
        {
            "$id": "animated-album-cover",
            "name": "animated-album-cover",
            "runtime": "node-26",
            "buildSpecification": "s-2vcpu-2gb",
            "runtimeSpecification": "s-0.5vcpu-512mb",
            "execute": [
                "any"
            ],
            "events": [],
            "scopes": [
                "rows.read",
                "rows.write"
            ],
            "schedule": "",
            "interval": 1440,
            "timeout": 30,
            "enabled": true,
            "logging": true,
            "entrypoint": "dist/main.js",
            "commands": "npm install && npm run build",
            "ignore": [
                "node_modules",
                ".npm"
            ],
            "deploymentRetention": 0,
            "path": "."
        }
    ],
    "databases": [
        {
            "$id": "cover-cache",
            "name": "Cover cache",
            "enabled": true
        }
    ]
}